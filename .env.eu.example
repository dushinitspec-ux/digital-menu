# Европейский контур: сервер, база и медиа — в ЕС (GDPR). Доступ к ним — только из ЕС/стран с решением об адекватности.
REGION=eu
BRAND_NAME=Menu Boards
APP_DOMAIN=app.example.com
PUBLIC_URL=https://app.example.com
OTHER_REGION_URL=https://app.example.ru

POSTGRES_PASSWORD=change-me-long-random

# Scaleway Object Storage (Париж). Hetzner Object Storage тоже подходит, но Hetzner не обслуживает
# клиентов с российским адресом. Бакет с публичным чтением и CORS для GET с APP_DOMAIN.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=example-menu-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_BASE_URL=https://example-menu-media.s3.fr-par.scw.cloud

BACKUP_BUCKET=example-menu-backups
