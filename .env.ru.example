# Российский контур: сервер, база и медиа — в РФ (ч. 5 ст. 18 152-ФЗ).
# Без Cloudflare и иностранных CDN: в РФ их замедляют, а данные не должны уходить за рубеж.
REGION=ru
BRAND_NAME=Меню на ТВ
APP_DOMAIN=app.example.ru
PUBLIC_URL=https://app.example.ru
OTHER_REGION_URL=https://app.example.com

POSTGRES_PASSWORD=change-me-long-random

# Медиа в Yandex Object Storage (или Selectel S3). Бакет с публичным чтением и CORS для GET с APP_DOMAIN.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=example-menu-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Yandex Cloud CDN перед бакетом или прямой адрес бакета.
MEDIA_BASE_URL=https://storage.yandexcloud.net/example-menu-media

# Для deploy/backup.sh
BACKUP_BUCKET=example-menu-backups
